# Bazaar — MagicBlock Solana Blitz v10
# Copy to .env and fill in values

# ── Solana RPCs ──
BASE_RPC_URL=https://api.devnet.solana.com
ER_RPC_URL=https://devnet.magicblock.app
PRIVATE_ER_RPC_URL=https://devnet-per.magicblock.app

# ── Program ID (set after deploy) ──
PROGRAM_ID=

# ── Keeper wallet path (devnet funded) ──
KEEPER_WALLET_PATH=./keeper-wallet.json

# ── Feature flags ──
# If Private ER is unavailable, set to "true" for commit-reveal fallback
USE_COMMIT_REVEAL_FALLBACK=false

# ── Game defaults ──
DEFAULT_STAKE_LAMPORTS=1000000
ROUND_DURATION_SECS=300
BASE_DEMAND=5
